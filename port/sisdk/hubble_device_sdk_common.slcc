id: hubble-device-sdk-common
label: Hubble Device SDK Common
package: hubble-device-sdk
description: >
  Core of the Hubble Device SDK, shared by the BLE and Satellite components.
category: Hubble
quality: production

provides:
  - name: hubble-device-sdk-common

source:
  - path: src/hubble.c
  - path: src/hubble_crypto.c
  - path: src/crypto/psa.c
  - path: port/sisdk/hubble_sisdk.c
  - path: port/freertos/hubble_freertos.c

include:
  - path: include
    file_list:
      - path: hubble/hubble.h
      - path: hubble/toolchain.h
      - path: hubble/version.h
      - path: hubble/port/sys.h
      - path: hubble/port/crypto.h
      - path: hubble/port/sat_radio.h
      - path: hubble/sat/packet.h
  - path: src
    file_list:
      - path: hubble_priv.h
      - path: utils/macros.h
      - path: utils/hdcv.h

config_file:
  - path: port/sisdk/hubble_config.h

toolchain_settings:
    - option: gcc_compiler_option
      value: "-imacros hubble_config.h"

requires:
  - name: app_log
  - name: freertos
  - name: psa_crypto_cmac
  - name: psa_crypto_cipher_ctr

documentation:
  url: https://hubblenetwork.github.io/hubble-device-sdk/main/

template_contribution:
  - name: component_catalog
    value: hubble_device_sdk_common
