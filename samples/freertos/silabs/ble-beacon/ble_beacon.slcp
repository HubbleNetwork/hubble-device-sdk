project_name: ble_beacon
package: hubble-device-sdk
quality: production
label: Hubble Device SDK - BLE Beacon Sample App
description: >
  Broadcasts Hubble Network encrypted advertisements over Bluetooth LE.
category: Hubble|BLE

sdk_extension:
  - id: hubble-device-sdk
    vendor: hubble-network
    version: 3.1.0

component:
  - id: hubble-device-sdk-component
    from: hubble-device-sdk
  - id: freertos
  - id: memory_manager
  - id: bluetooth_stack
  - id: bluetooth_feature_legacy_advertiser
  - id: bluetooth_feature_sm
  - id: bluetooth_feature_system
  - id: app_assert
  - id: mpu
  - id: sl_main
  - id: clock_manager
  - id: device_init

source:
  - path: src/app.c

other_file:
  - path: src/key.c
  - path: src/time.c

filter:
  - name: "Wireless Technology"
    value: ["Bluetooth"]
  - name: "Device Type"
    value: ["SoC"]
  - name: "Project Difficulty"
    value: ["Beginner"]

readme:
  - path: README.md

ui_hints:
  highlight:
    - path: README.md

configuration:
  - name: SL_STACK_SIZE
    value: "2000"
  - name: configTOTAL_HEAP_SIZE
    value: "5000"
  - name: configTIMER_TASK_STACK_DEPTH
    value: "240"
  - name: SL_PSA_KEY_USER_SLOT_COUNT
    value: "0"
    condition:
      - psa_crypto
  - name: SL_BOARD_ENABLE_VCOM
    value: "1"
  - name: SL_IOSTREAM_EUSART_VCOM_CONVERT_BY_DEFAULT_LF_TO_CRLF
    value: "1"

tag:
  - hwfilter:device:device_supports_bluetooth
